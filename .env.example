# ─────────────────────────────── Discord ───────────────────────────────
# Bot-Token aus dem Developer Portal: Applications → dein Bot → "Bot" → "Reset Token"
DISCORD_TOKEN=
# ID deines Servers: Discord → Einstellungen → Erweitert → Entwicklermodus an,
# dann Rechtsklick auf den Server → "Server-ID kopieren"
GUILD_ID=
# Online-Status, Custom-Status & "Spielt gerade …" auf den Profilen zeigen?
# Dafür im Developer Portal unter "Bot" den "Presence Intent" einschalten und hier true setzen.
DISCORD_PRESENCE_INTENT=false

# ─────────────────────────────── Website ───────────────────────────────
# Öffentliche Adresse der Website (ohne / am Ende). Genau diese Links landen in den Bios!
PUBLIC_URL=http://localhost:3000
PORT=3000
# Läuft die Seite hinter einem Reverse-Proxy (Caddy, nginx, Cloudflare Tunnel …)? Dann 1 eintragen.
TRUST_PROXY=
# Optional: eigener Seitenname (sonst der Servername aus Discord)
SITE_NAME=
# Dürfen Google & Co. die Profile finden? Standard: nein
ALLOW_INDEXING=false

# ─────────────────────────────── Sonstiges ─────────────────────────────
# Wo Profile & Bilder gespeichert werden (davon Backups machen!)
DATA_DIR=data
# Maximale Größe für hochgeladene Bilder in MB
MAX_UPLOAD_MB=8
# Wie lange der Login-Link vom Bot gültig ist (Minuten)
LOGIN_LINK_MINUTES=15
# Wie lange man im Editor eingeloggt bleibt (Tage)
SESSION_DAYS=14
