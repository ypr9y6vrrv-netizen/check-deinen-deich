{
  "name": "deich-profile",
  "version": "1.0.0",
  "private": true,
  "description": "Discord-Bot + Website: Jedes Server-Mitglied gestaltet sein eigenes Profil und packt den Link in die Bio.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "demo": "node src/index.js --demo",
    "test": "node --test test/*.test.js",
    "assets": "node scripts/build-assets.js"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "express": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "simple-icons": "^16.38.0"
  }
}
